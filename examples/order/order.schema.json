{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An order with its lines.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "xml": {
        "attribute": true
      }
    },
    "created": {
      "type": "string",
      "pattern": "^(?:(?:-?(?:[1-9][0-9]{3,}|0[0-9]{2}[1-9]|0[0-9][1-9][0-9]|0[1-9][0-9]{2})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|-?(?:[1-9][0-9]*(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)|[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?|(?:24:00:00(?:\\.0+)?))(?:Z|(?:\\+|-)(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))?)$",
      "xml": {
        "attribute": true,
        "whiteSpace": "collapse"
      }
    },
    "channel": {
      "$ref": "#/$defs/Channel",
      "default": "web",
      "xml": {
        "attribute": true
      }
    },
    "Title": {
      "$ref": "#/$defs/Text40",
      "xml": {
        "namespace": "urn:example:order"
      }
    },
    "CustomerRef": {
      "type": "string",
      "xml": {
        "namespace": "urn:example:order",
        "type": "{http://www.w3.org/2001/XMLSchema}string"
      }
    },
    "Express": {
      "type": "boolean",
      "xml": {
        "namespace": "urn:example:order",
        "type": "{http://www.w3.org/2001/XMLSchema}boolean"
      }
    },
    "Level": {
      "$ref": "#/$defs/ServiceLevel",
      "xml": {
        "namespace": "urn:example:order"
      }
    },
    "Pickup": {
      "description": "The customer collects the order.",
      "type": "boolean",
      "xml": {
        "namespace": "urn:example:order",
        "type": "{http://www.w3.org/2001/XMLSchema}boolean"
      },
      "const": true
    },
    "DeliveryDate": {
      "type": "string",
      "pattern": "^(?:(?:-?(?:[1-9][0-9]{3,}|0[0-9]{2}[1-9]|0[0-9][1-9][0-9]|0[1-9][0-9]{2})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|-?(?:[1-9][0-9]*(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)|[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)(?:Z|(?:\\+|-)(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))?)$",
      "xml": {
        "namespace": "urn:example:order",
        "whiteSpace": "collapse",
        "type": "{http://www.w3.org/2001/XMLSchema}date"
      }
    },
    "DeliveryTime": {
      "type": "string",
      "pattern": "^(?:(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?|(?:24:00:00(?:\\.0+)?))(?:Z|(?:\\+|-)(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))?)$",
      "xml": {
        "namespace": "urn:example:order",
        "whiteSpace": "collapse",
        "type": "{http://www.w3.org/2001/XMLSchema}time"
      }
    },
    "Wanted": {
      "$ref": "#/$defs/PartialDate",
      "xml": {
        "namespace": "urn:example:order"
      }
    },
    "Packages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99,
      "xml": {
        "namespace": "urn:example:order"
      }
    },
    "Note": {
      "description": "Free text that may mark words as bold or italic.",
      "$ref": "#/$defs/Note",
      "xml": {
        "namespace": "urn:example:common"
      }
    },
    "DiscountCode": {
      "type": "string",
      "xml": {
        "namespace": "urn:example:order",
        "whiteSpace": "collapse",
        "type": "{http://www.w3.org/2001/XMLSchema}token"
      }
    },
    "DiscountPercent": {
      "$ref": "#/$defs/Percent",
      "xml": {
        "namespace": "urn:example:order"
      }
    },
    "Contact": {
      "$ref": "#/$defs/Contact",
      "xml": {
        "namespace": "urn:example:order"
      }
    },
    "Line": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Line"
      },
      "minItems": 1,
      "maxItems": 5,
      "xml": {
        "namespace": "urn:example:order"
      }
    },
    "Attachment": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:(?:(?:(?:[A-Za-z0-9+/] ?){4})*(?:[A-Za-z0-9+/] ?[A-Za-z0-9+/] ?[A-Za-z0-9+/] ?[A-Za-z0-9+/]|[A-Za-z0-9+/] ?[A-Za-z0-9+/] ?[AEIMQUYcgkosw048] ?=|[A-Za-z0-9+/] ?[AQgw] ?= ?=))?)$",
      "xml": {
        "namespace": "urn:example:order",
        "whiteSpace": "collapse",
        "type": "{http://www.w3.org/2001/XMLSchema}base64Binary"
      }
    },
    "Extensions": {
      "description": "Data of other systems, in their own namespaces.",
      "type": "object",
      "xml": {
        "namespace": "urn:example:order",
        "anyElement": true
      }
    }
  },
  "required": [
    "created",
    "Title",
    "Express",
    "Line"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "DiscountCode": [
      "DiscountPercent"
    ],
    "DiscountPercent": [
      "DiscountCode"
    ]
  },
  "oneOf": [
    {
      "required": [
        "Pickup"
      ],
      "properties": {
        "DeliveryDate": false,
        "DeliveryTime": false
      }
    },
    {
      "required": [
        "DeliveryDate"
      ],
      "properties": {
        "Pickup": false
      }
    }
  ],
  "xml": {
    "name": "Order",
    "namespace": "urn:example:order"
  },
  "$defs": {
    "Text40": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "xml": {
        "type": "{urn:example:common}Text40"
      }
    },
    "ServiceLevel": {
      "type": "integer",
      "enum": [
        0,
        1,
        2
      ],
      "xml": {
        "type": "{urn:example:common}ServiceLevel"
      }
    },
    "PartialDate": {
      "description": "A month or a day.",
      "type": "string",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:-?(?:[1-9][0-9]{3,}|0[0-9]{2}[1-9]|0[0-9][1-9][0-9]|0[1-9][0-9]{2})-(?:0[1-9]|1[0-2])(?:Z|(?:\\+|-)(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))?)$",
          "xml": {
            "whiteSpace": "collapse"
          }
        },
        {
          "type": "string",
          "pattern": "^(?:(?:-?(?:[1-9][0-9]{3,}|0[0-9]{2}[1-9]|0[0-9][1-9][0-9]|0[1-9][0-9]{2})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|-?(?:[1-9][0-9]*(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)|[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)(?:Z|(?:\\+|-)(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))?)$",
          "xml": {
            "whiteSpace": "collapse"
          }
        }
      ],
      "xml": {
        "whiteSpace": "collapse",
        "type": "{urn:example:order}PartialDate"
      }
    },
    "Note": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "xml": {
            "text": true,
            "mixed": true
          }
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "Percent": {
      "type": "number",
      "multipleOf": 0.1,
      "minimum": 0,
      "maximum": 100,
      "xml": {
        "type": "{urn:example:common}Percent"
      }
    },
    "Contact": {
      "type": "object",
      "properties": {
        "#type": {
          "const": "{urn:example:common}Contact",
          "xml": {
            "xsiType": true
          }
        },
        "Name": {
          "$ref": "#/$defs/Text40",
          "xml": {
            "namespace": "urn:example:common"
          }
        },
        "Email": {
          "$ref": "#/$defs/Email",
          "xml": {
            "namespace": "urn:example:common"
          }
        },
        "Phone": {
          "type": "string",
          "xml": {
            "namespace": "urn:example:common",
            "type": "{http://www.w3.org/2001/XMLSchema}string"
          }
        }
      },
      "required": [
        "Name",
        "Email"
      ],
      "additionalProperties": false
    },
    "Line": {
      "type": "object",
      "properties": {
        "#type": {
          "const": "{urn:example:order}Line",
          "xml": {
            "xsiType": true
          }
        },
        "Item": {
          "$ref": "#/$defs/Text40",
          "xml": {
            "namespace": "urn:example:order"
          }
        },
        "Quantity": {
          "type": "integer",
          "minimum": 1,
          "xml": {
            "namespace": "urn:example:order",
            "type": "{http://www.w3.org/2001/XMLSchema}positiveInteger"
          }
        },
        "Price": {
          "$ref": "#/$defs/Price",
          "xml": {
            "namespace": "urn:example:order"
          }
        },
        "Tag": {
          "type": "array",
          "items": {
            "type": "string",
            "xml": {
              "type": "{http://www.w3.org/2001/XMLSchema}string"
            }
          },
          "maxItems": 3,
          "xml": {
            "namespace": "urn:example:order"
          }
        },
        "Packaging": {
          "type": "object",
          "properties": {
            "Box": {
              "$ref": "#/$defs/BoxSize",
              "xml": {
                "namespace": "urn:example:order"
              }
            },
            "Weight": {
              "$ref": "#/$defs/Kilogram",
              "xml": {
                "namespace": "urn:example:order"
              }
            }
          },
          "required": [
            "Box"
          ],
          "additionalProperties": false,
          "xml": {
            "namespace": "urn:example:order"
          }
        }
      },
      "required": [
        "Item",
        "Quantity"
      ],
      "additionalProperties": false
    },
    "Channel": {
      "type": "string",
      "enum": [
        "web",
        "phone",
        "mail"
      ],
      "xml": {
        "whiteSpace": "collapse",
        "type": "{urn:example:order}Channel"
      }
    },
    "Email": {
      "type": "string",
      "pattern": "^(?:[^@ ]+@[^@ ]+)$",
      "xml": {
        "type": "{urn:example:common}Email"
      }
    },
    "Price": {
      "description": "An amount that always says its currency.",
      "type": "object",
      "properties": {
        "#type": {
          "const": "{urn:example:common}Price",
          "xml": {
            "xsiType": true
          }
        },
        "currency": {
          "$ref": "#/$defs/Currency",
          "xml": {
            "attribute": true
          }
        },
        "value": {
          "type": "number",
          "xml": {
            "text": true
          }
        }
      },
      "required": [
        "currency",
        "value"
      ],
      "additionalProperties": false
    },
    "BoxSize": {
      "type": "string",
      "enum": [
        "S",
        "M",
        "L"
      ],
      "xml": {
        "type": "{urn:example:order}BoxSize"
      }
    },
    "Kilogram": {
      "type": "number",
      "multipleOf": 0.01,
      "exclusiveMinimum": 0,
      "xml": {
        "type": "{urn:example:common}Kilogram"
      }
    },
    "Currency": {
      "type": "string",
      "pattern": "^(?:[A-Z]{3})$",
      "xml": {
        "type": "{urn:example:common}Currency"
      }
    }
  }
}

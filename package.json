{
  "name": "xsd-to-jsonschema",
  "version": "1.0.0",
  "description": "Converts XML Schemas into JSON Schema 2020-12.",
  "scripts": {
    "test": "vitest run",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "prepack": "npm run build",
    "example": "npm run build && node dist/bin.js examples/order/order.xsd"
  },
  "keywords": [
    "xsd",
    "xml-schema",
    "json-schema",
    "2020-12"
  ],
  "type": "module",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "xmllint-wasm": "^5.3.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "allowScripts": {
    "fsevents": false
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "docs",
    "examples/order",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "xsd-to-jsonschema": "dist/bin.js",
    "xsd2json": "dist/bin.js"
  },
  "license": "MIT"
}
